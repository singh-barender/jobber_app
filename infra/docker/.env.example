# Template for .env (git-ignored). Copy it, then replace every "change-me":
#   cp .env.example .env
#
# Local development only. Use real secrets (Kubernetes Secrets) when deploying.
# Tip: add a QUICK ACCESS comment block at the top of your .env with your URLs, logins
# and connection strings, so everything is in one private place.
# Your apps need the same values in their own .env files.

# MySQL (auth)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=jobber
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=jobber_auth

# PostgreSQL (reviews)
POSTGRES_USER=jobber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobber_reviews

# RabbitMQ
RABBITMQ_DEFAULT_USER=jobber
RABBITMQ_DEFAULT_PASS=change-me

# Elasticsearch and Kibana
# ELASTIC_PASSWORD: the "elastic" superuser (Kibana login, apps' Elasticsearch URL).
# KIBANA_PASSWORD: Kibana's internal user, set automatically. You never log in with it.
# KIBANA_ENCRYPTION_KEY: 32+ characters. Generate one with: openssl rand -hex 16
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me
KIBANA_ENCRYPTION_KEY=change-me-to-a-random-string-of-32-or-more-characters
