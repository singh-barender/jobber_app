{
  "name": "@singh-barender/jobber-shared",
  "version": "1.0.0",
  "description": "Shared types, errors, logger and helpers used by every Jobber microservice",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "jobber",
    "microservices",
    "shared",
    "typescript"
  ],
