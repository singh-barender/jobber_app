  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
